libkcddb4
libdb4.4++
libbluetooth2
libltdl3
libopensync0
textutils
libsnmp10
libmyspell3c2
libdb4.2
libdb4.3
libdb4.4
libdb4.5
libiw29
libmaildir4
libcurl3
libgadu3
libtunepimp5
gdk-imlib1
libexiv2-4
libgpmg1
libstrigiqtdbusclient0
libdns45
libhunspell-1.1-0
libmikmod2
libdb3
librasqal0
sysvutils
libsasl7
libcupsys2

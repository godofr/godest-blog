[root@andLinux godo]#

</pre>

<p>
Y purgamos:
</p>

<pre class="example" id="org300c496">

[root@andLinux godo]# dpkg --purge libtasn1-2 liblzo2-2 libsnmp-base liblzo1 libofa0 libopencdk8 libmusicbrainz4c2a libopencdk10
(Leyendo la base de datos ...
